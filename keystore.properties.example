# Copy this file to keystore.properties and replace every placeholder.
# keystore.properties and common Android keystore extensions are ignored by Git.
storeFile=.signing/candy-release.keystore
storePassword=replace-me
keyAlias=candy
keyPassword=replace-me

# Google Play uses a separate upload key. The original release key remains the app signing key.
playStoreFile=.signing/candy-play-upload.keystore
playStorePassword=replace-me
playKeyAlias=candy-play-upload
playKeyPassword=replace-me
