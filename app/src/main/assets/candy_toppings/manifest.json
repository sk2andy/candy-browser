{
  "manifest_version": 3,
  "name": "Candy Topping Host",
  "version": "1.2.0",
  "browser_specific_settings": {
    "gecko": {
      "id": "candy-topping-host@sk2andy.dev"
    }
  },
  "background": {
    "scripts": [
      "background.js"
    ]
  },
  "content_scripts": [
    {
      "matches": [
        "http://*/*",
        "https://*/*"
      ],
      "js": [
        "session_gate.js"
      ],
      "run_at": "document_start",
      "all_frames": true
    }
  ],
  "permissions": [
    "geckoViewAddons",
    "nativeMessaging",
    "nativeMessagingFromContent"
  ],
  "optional_permissions": [
    "userScripts"
  ],
  "host_permissions": [
    "http://*/*",
    "https://*/*"
  ]
}
