{
  "manifest_version": 3,
  "name": "Candy Privacy Host",
  "version": "1.1.4",
  "browser_specific_settings": {
    "gecko": {
      "id": "candy-privacy-host@sk2andy.dev"
    }
  },
  "background": {
    "scripts": ["rules.js", "background.js"]
  },
  "content_scripts": [
    {
      "matches": ["http://*/*", "https://*/*"],
      "js": ["content.js"],
      "run_at": "document_start",
      "all_frames": true
    }
  ],
  "permissions": [
    "geckoViewAddons",
    "nativeMessaging",
    "webRequest",
    "webRequestBlocking"
  ],
  "host_permissions": [
    "http://*/*",
    "https://*/*"
  ]
}
