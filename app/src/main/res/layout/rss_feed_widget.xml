<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg_rss_widget"
    android:orientation="vertical"
    android:padding="16dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <!-- RemoteViews inflates a framework ImageView, so tint must use the Android attribute. -->
        <ImageView
            android:layout_width="38dp"
            android:layout_height="38dp"
            android:background="@drawable/bg_rss_widget_icon"
            android:contentDescription="@null"
            android:padding="9dp"
            android:src="@drawable/ic_rss"
            android:tint="@color/candy_widget_accent"
            tools:ignore="UseAppTint" />

        <TextView
            android:id="@+id/rss_widget_title"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="10dp"
            android:layout_weight="1"
            android:text="@string/rss_widget_title"
            android:textColor="@color/candy_widget_on_surface"
            android:textSize="16sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/rss_widget_count"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_rss_widget_badge"
            android:paddingHorizontal="10dp"
            android:paddingVertical="5dp"
            android:textColor="@color/candy_widget_accent"
            android:textSize="12sp"
            android:textStyle="bold" />
    </LinearLayout>

    <TextView
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:layout_marginTop="10dp"
        android:background="@color/candy_widget_divider" />

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <ListView
            android:id="@+id/rss_widget_articles"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:divider="@color/candy_widget_divider"
            android:dividerHeight="1dp"
            android:scrollbars="vertical" />

        <TextView
            android:id="@+id/rss_widget_empty"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:gravity="center"
            android:text="@string/rss_widget_empty"
            android:textColor="@color/candy_widget_on_surface_variant"
            android:textSize="14sp"
            android:visibility="gone" />
    </FrameLayout>

    <TextView
        android:id="@+id/rss_widget_all_feeds"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="end"
        android:paddingTop="8dp"
        android:text="@string/browser_menu_discover_feeds"
        android:textColor="@color/candy_widget_accent"
        android:textSize="12sp"
        android:textStyle="bold" />
</LinearLayout>
