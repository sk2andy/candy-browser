    <string name="settings_search_shortcuts_title">Arama kısayolları</string>
    <string name="settings_search_shortcuts_summary">GitHub için !gh, YouTube için !yt gibi kısayollar oluşturun. Ardına boşluk yazınca çipe dönüşür. Arama önerileri çalışmaya devam eder. Boş sorguda Geri tuşu çipi kaldırır.</string>
    <string name="settings_search_shortcut_keyword">Kısayol</string>
    <string name="settings_search_shortcut_keyword_summary">Örneğin !gh. En fazla 32 harf, rakam, kısa çizgi veya alt çizgi kullanın. ! sonrasında harf veya rakamla başlayın.</string>
    <string name="settings_search_shortcut_template">Arama URL şablonu</string>
    <string name="settings_search_shortcut_template_summary" formatted="false">Web sitesinin arama URL adresini kopyalayıp arama terimlerini %s ile değiştirin. HTTP veya HTTPS adresinde tam bir %s kullanın.</string>
