{
  "manifest_version": 2,
  "browser_specific_settings": { "gecko": { "id": "fxa@mozac.org" } },
  "name": "Candy Mozilla Account WebChannel",
  "version": "1.0",
  "incognito": "not_allowed",
  "content_scripts": [{
    "matches": ["https://accounts.firefox.com/*"],
    "js": ["fxawebchannel.js"],
    "run_at": "document_start",
    "all_frames": false
  }],
  "permissions": ["mozillaAddons", "geckoViewAddons", "nativeMessaging", "nativeMessagingFromContent"]
}
