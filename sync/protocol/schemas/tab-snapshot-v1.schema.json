{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://candybrowser.dev/sync/protocol/schemas/tab-snapshot-v1.schema.json",
  "title": "Candy Sync encrypted tab snapshot v1",
  "description": "Latest target-device encrypted tab snapshot. deviceId identifies its authenticated writer; entityId identifies its target synced profile.",
  "$ref": "#/$defs/serverSnapshot",
  "$defs": {
    "identifier": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128,
      "pattern": "^[A-Za-z0-9_-]+$"
    },
    "revision": {
      "type": "string",
      "pattern": "^(0|[1-9][0-9]{0,18})$"
    },
    "nonce": {
      "type": "string",
      "pattern": "^[A-Za-z0-9_-]{16}$"
    },
    "ciphertext": {
      "description": "AES-256-GCM ciphertext with included 16-byte tag, unpadded base64url.",
      "type": "string",
      "minLength": 22,
      "maxLength": 524288,
      "pattern": "^[A-Za-z0-9_-]+$"
    },
    "envelope": {
      "type": "object",
      "additionalProperties": false,
      "required": ["revision", "schemaVersion", "cryptoVersion", "keyVersion", "nonce", "ciphertext"],
      "properties": {
        "revision": { "$ref": "#/$defs/revision" },
        "schemaVersion": { "const": 1 },
        "cryptoVersion": { "const": 1 },
        "keyVersion": { "type": "integer", "minimum": 1, "maximum": 2147483647 },
        "nonce": { "$ref": "#/$defs/nonce" },
        "ciphertext": { "$ref": "#/$defs/ciphertext" }
      }
    },
    "putRequest": {
      "type": "object",
      "additionalProperties": false,
      "required": ["changeId", "expectedRevision", "revision", "schemaVersion", "cryptoVersion", "keyVersion", "nonce", "ciphertext"],
      "properties": {
        "changeId": { "$ref": "#/$defs/identifier" },
        "expectedRevision": { "$ref": "#/$defs/revision" },
        "revision": { "$ref": "#/$defs/revision" },
        "schemaVersion": { "const": 1 },
        "cryptoVersion": { "const": 1 },
        "keyVersion": { "type": "integer", "minimum": 1, "maximum": 2147483647 },
        "nonce": { "$ref": "#/$defs/nonce" },
        "ciphertext": { "$ref": "#/$defs/ciphertext" }
      }
    },
    "serverSnapshot": {
      "type": "object",
      "additionalProperties": false,
      "required": ["changeId", "deviceId", "entity", "entityId", "operation", "baseRevision", "revision", "schemaVersion", "cryptoVersion", "keyVersion", "nonce", "ciphertext"],
      "properties": {
        "changeId": { "$ref": "#/$defs/identifier" },
        "deviceId": { "$ref": "#/$defs/identifier" },
        "entity": { "const": "tabs" },
        "entityId": { "$ref": "#/$defs/identifier" },
        "operation": { "const": "snapshot" },
        "baseRevision": { "$ref": "#/$defs/revision" },
        "revision": { "$ref": "#/$defs/revision" },
        "schemaVersion": { "const": 1 },
        "cryptoVersion": { "const": 1 },
        "keyVersion": { "type": "integer", "minimum": 1, "maximum": 2147483647 },
        "nonce": { "$ref": "#/$defs/nonce" },
        "ciphertext": { "$ref": "#/$defs/ciphertext" }
      }
    }
  }
}
