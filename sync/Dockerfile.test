# syntax=docker/dockerfile:1.7
FROM golang:1.27.1-alpine3.23 AS go-toolchain

FROM node:24.10.0-alpine3.22

COPY --from=go-toolchain /usr/local/go /usr/local/go
ENV PATH="/usr/local/go/bin:${PATH}"

RUN apk add --no-cache build-base curl
WORKDIR /workspace/sync

COPY server/go.mod server/go.sum ./server/
RUN --mount=type=cache,target=/go/pkg/mod cd server && go mod download

COPY extension/package.json extension/package-lock.json ./extension/
RUN --mount=type=cache,target=/root/.npm cd extension && npm ci && npm audit --audit-level=moderate

COPY . .

CMD ["/workspace/sync/scripts/test-inside.sh"]
